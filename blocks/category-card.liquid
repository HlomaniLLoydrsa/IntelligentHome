{% doc %}
  Renders a category card with image, title, and link.
  Used inside the featured-categories section.

  @example
  {% content_for 'block', type: 'category-card', id: 'kitchen' %}
{% enddoc %}

<a href="{{ block.settings.url | default: '#' }}" class="category-card" data-stagger-item {{ block.shopify_attributes }}>
  <div class="category-card__image-wrapper">
    {% if block.settings.image %}
      <img
        src="{{ block.settings.image | image_url: width: 800 }}"
        alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
        width="800"
        height="{{ 800 | divided_by: block.settings.image.aspect_ratio | round }}"
        loading="lazy"
        class="category-card__image"
      >
    {% else %}
      <div class="category-card__placeholder">
        {% assign cat_handle = block.settings.title | handleize %}
        <img
          src="{{ 'category-' | append: cat_handle | append: '.svg' | asset_url }}"
          alt="{{ block.settings.title | escape }}"
          width="400"
          height="300"
          loading="lazy"
        >
      </div>
    {% endif %}
  </div>
  <div class="category-card__content">
    <h3 class="category-card__title">{{ block.settings.title | escape }}</h3>
    <span class="category-card__cta">{{ 'sections.featured_categories.shop_now' | t }}</span>
  </div>
</a>

{% stylesheet %}
  .category-card {
    display: block;
    position: relative;
    overflow: hidden;
    border-radius: var(--border-radius);
    text-decoration: none;
    color: inherit;
  }

  .category-card__image-wrapper {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background-color: var(--color-surface-alt);
  }

  .category-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .category-card:hover .category-card__image {
    transform: scale(1.05);
  }

  .category-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-2xl);
  }

  .category-card__placeholder svg {
    width: 60%;
    height: auto;
    opacity: 0.3;
  }

  .category-card__content {
    padding: var(--space-lg) 0 var(--space-sm);
  }

  .category-card__title {
    font-family: var(--font-heading-family);
    font-size: var(--text-lg);
    font-weight: 600;
    margin: 0;
    color: var(--color-foreground);
  }

  .category-card__cta {
    display: inline-block;
    margin-top: var(--space-xs);
    font-size: var(--text-sm);
    color: var(--color-primary);
    font-weight: 500;
  }

  .category-card:hover .category-card__cta {
    color: var(--color-accent);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.featured_categories.category",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:labels.title",
      "default": "Category"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "url",
      "id": "url",
      "label": "t:labels.link"
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured_categories.category"
    }
  ]
}
{% endschema %}
