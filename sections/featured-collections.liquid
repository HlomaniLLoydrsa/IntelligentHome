<section class="featured-collections">
  {% if section.settings.heading != blank %}
    <h2 class="featured-collections__heading">{{ section.settings.heading | escape }}</h2>
  {% endif %}

  <div class="featured-collections__grid">
    {% for block in section.blocks %}
      <a href="{{ block.settings.collection.url | default: '#' }}" class="collection-card" {{ block.shopify_attributes }}>
        <div class="collection-card__image-wrapper">
          {% if block.settings.image %}
            <img
              src="{{ block.settings.image | image_url: width: 600 }}"
              alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
              width="600"
              height="{{ 600 | divided_by: block.settings.image.aspect_ratio | round }}"
              loading="lazy"
              class="collection-card__image"
            >
          {% elsif block.settings.collection.image %}
            <img
              src="{{ block.settings.collection.image | image_url: width: 600 }}"
              alt="{{ block.settings.collection.title | escape }}"
              width="600"
              height="{{ 600 | divided_by: block.settings.collection.image.aspect_ratio | round }}"
              loading="lazy"
              class="collection-card__image"
            >
          {% else %}
            <div class="collection-card__placeholder">
              {{ 'collection-1' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
        <div class="collection-card__content">
          <h3 class="collection-card__title">
            {% if block.settings.title != blank %}
              {{ block.settings.title | escape }}
            {% elsif block.settings.collection %}
              {{ block.settings.collection.title | escape }}
            {% else %}
              {{ 'sections.featured_collections.collection' | t }}
            {% endif %}
          </h3>
          <span class="collection-card__cta">{{ 'sections.featured_categories.shop_now' | t }}</span>
        </div>
      </a>
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .featured-collections {
    padding: var(--space-4xl) 0;
  }

  .featured-collections__heading {
    text-align: center;
    font-size: var(--text-3xl);
    margin: 0 0 var(--space-2xl);
    color: var(--color-foreground);
  }

  .featured-collections__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-xl);
  }

  .collection-card {
    display: block;
    text-decoration: none;
    color: inherit;
    border-radius: var(--border-radius);
    overflow: hidden;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }

  .collection-card:hover {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    transform: translateY(-2px);
  }

  .collection-card__image-wrapper {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background-color: var(--color-surface-alt);
  }

  .collection-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .collection-card:hover .collection-card__image {
    transform: scale(1.03);
  }

  .collection-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-2xl);
  }

  .collection-card__placeholder svg {
    width: 50%;
    height: auto;
    opacity: 0.3;
  }

  .collection-card__content {
    padding: var(--space-lg);
    text-align: center;
  }

  .collection-card__title {
    font-family: var(--font-heading-family);
    font-size: var(--text-base);
    font-weight: 600;
    margin: 0;
    color: var(--color-foreground);
  }

  .collection-card__cta {
    display: inline-block;
    margin-top: var(--space-xs);
    font-size: var(--text-sm);
    color: var(--color-primary);
    font-weight: 500;
  }

  .collection-card:hover .collection-card__cta {
    color: var(--color-primary-dark);
  }

  @media (max-width: 1023px) {
    .featured-collections__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 767px) {
    .featured-collections {
      padding: var(--space-3xl) 0;
    }

    .featured-collections__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-md);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.featured_collections.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Featured collections"
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "t:general.collection_card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:labels.collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:labels.title"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured_collections.name",
      "blocks": [
        {
          "type": "collection_card",
          "settings": {
            "title": "Kitchen essentials"
          }
        },
        {
          "type": "collection_card",
          "settings": {
            "title": "Cleaning essentials"
          }
        },
        {
          "type": "collection_card",
          "settings": {
            "title": "Storage & organization"
          }
        },
        {
          "type": "collection_card",
          "settings": {
            "title": "Best sellers"
          }
        }
      ]
    }
  ]
}
{% endschema %}
