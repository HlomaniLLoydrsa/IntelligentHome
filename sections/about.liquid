<section class="about-page">
  <div class="about-page__hero">
    {% if section.settings.hero_image %}
      <div class="about-page__hero-image">
        <img
          src="{{ section.settings.hero_image | image_url: width: 1200 }}"
          alt="{{ section.settings.heading | escape }}"
          width="1200"
          height="{{ 1200 | divided_by: section.settings.hero_image.aspect_ratio | round }}"
        >
      </div>
    {% endif %}
    <h1 class="about-page__title">{{ section.settings.heading | escape }}</h1>
    {% if section.settings.subtitle != blank %}
      <p class="about-page__subtitle">{{ section.settings.subtitle | escape }}</p>
    {% endif %}
  </div>

  {% if section.settings.story != blank %}
    <div class="about-page__section">
      <h2>{{ 'sections.about.our_story' | t }}</h2>
      <div class="about-page__text">{{ section.settings.story }}</div>
    </div>
  {% endif %}

  {% if section.settings.mission != blank %}
    <div class="about-page__section">
      <h2>{{ 'sections.about.mission' | t }}</h2>
      <div class="about-page__text">{{ section.settings.mission }}</div>
    </div>
  {% endif %}

  {% if section.settings.vision != blank %}
    <div class="about-page__section">
      <h2>{{ 'sections.about.vision' | t }}</h2>
      <div class="about-page__text">{{ section.settings.vision }}</div>
    </div>
  {% endif %}
</section>

{% stylesheet %}
  .about-page { padding: var(--space-2xl) 0 var(--space-4xl); max-width: 48rem; margin: 0 auto; }
  .about-page__hero { text-align: center; margin-bottom: var(--space-3xl); }
  .about-page__hero-image { border-radius: var(--border-radius); overflow: hidden; margin-bottom: var(--space-2xl); }
  .about-page__hero-image img { width: 100%; height: auto; }
  .about-page__title { font-size: var(--text-4xl); margin: 0; }
  .about-page__subtitle { font-size: var(--text-lg); color: var(--color-secondary); margin: var(--space-md) 0 0; line-height: 1.6; }
  .about-page__section { margin-bottom: var(--space-3xl); }
  .about-page__section h2 { font-size: var(--text-2xl); margin: 0 0 var(--space-md); color: var(--color-foreground); }
  .about-page__text { font-size: var(--text-base); line-height: 1.8; color: var(--color-secondary); }
  .about-page__text p { margin: 0 0 var(--space-md); }
  .about-page__values { list-style: none; padding: 0; margin: var(--space-lg) 0 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-md); }
  .about-page__value { display: flex; align-items: center; gap: var(--space-sm); font-size: var(--text-base); color: var(--color-foreground); font-weight: 500; }
  .about-page__value::before { content: '✦'; color: var(--color-primary); }
  @media (max-width: 767px) { .about-page__title { font-size: var(--text-3xl); } .about-page__values { grid-template-columns: 1fr; } }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.about.name",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "About Intelligent Home" },
    { "type": "textarea", "id": "subtitle", "label": "t:labels.subheading", "default": "Premium home essentials designed to simplify everyday living." },
    { "type": "image_picker", "id": "hero_image", "label": "t:labels.image" },
    { "type": "richtext", "id": "story", "label": "t:sections.about.our_story", "default": "<p>We started Intelligent Home with a simple belief: everyday products should be beautiful, functional, and built to make life easier.</p><p>From kitchen accessories to cleaning essentials, every product we select is chosen for its quality, design, and practicality.</p>" },
    { "type": "richtext", "id": "mission", "label": "t:sections.about.mission", "default": "<p>To make premium home essentials accessible to everyone. We believe you shouldn't have to choose between quality and affordability.</p>" },
    { "type": "richtext", "id": "vision", "label": "t:sections.about.vision", "default": "<p>To become the most trusted destination for thoughtfully designed home products that simplify everyday living.</p>" }
  ],
  "presets": [{ "name": "t:sections.about.name" }]
}
{% endschema %}
