<section class="hero-banner full-width" style="--hero-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }}">
  {% if section.settings.background_image %}
    <div class="hero-banner__background">
      <img
        src="{{ section.settings.background_image | image_url: width: 1920 }}"
        alt="{{ section.settings.background_image.alt | default: '' | escape }}"
        width="1920"
        height="{{ 1920 | divided_by: section.settings.background_image.aspect_ratio | round }}"
        class="hero-banner__image"
      >
    </div>
  {% endif %}

  <div class="hero-banner__content">
    {% if section.settings.heading != blank %}
      <h1 class="hero-banner__heading">{{ section.settings.heading | escape }}</h1>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <p class="hero-banner__subheading">{{ section.settings.subheading | escape }}</p>
    {% endif %}

    <div class="hero-banner__actions">
      {% if section.settings.primary_cta_label != blank %}
        {% render 'button',
          label: section.settings.primary_cta_label,
          url: section.settings.primary_cta_url,
          style: 'primary'
        %}
      {% endif %}

      {% if section.settings.secondary_cta_label != blank %}
        {% render 'button',
          label: section.settings.secondary_cta_label,
          url: section.settings.secondary_cta_url,
          style: 'secondary'
        %}
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .hero-banner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 70vh;
    padding: var(--space-4xl) var(--page-margin);
    background-color: var(--color-surface-alt);
    overflow: hidden;
  }

  .hero-banner__background {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-banner__background::after {
    content: '';
    position: absolute;
    inset: 0;
    background-color: rgba(0, 0, 0, var(--hero-overlay-opacity));
  }

  .hero-banner__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-banner__content {
    position: relative;
    z-index: 1;
    max-width: 40rem;
    text-align: center;
  }

  .hero-banner__heading {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-size: var(--text-5xl);
    color: var(--color-foreground);
    margin: 0;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .hero-banner__subheading {
    font-family: var(--font-body-family);
    font-size: var(--text-lg);
    color: var(--color-secondary);
    margin: var(--space-lg) 0 0;
    line-height: 1.6;
    max-width: 32rem;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-banner__actions {
    display: flex;
    gap: var(--space-md);
    justify-content: center;
    flex-wrap: wrap;
    margin-top: var(--space-2xl);
  }

  /* When background image is present, use light text */
  .hero-banner:has(.hero-banner__background) .hero-banner__heading {
    color: #FFFFFF;
  }

  .hero-banner:has(.hero-banner__background) .hero-banner__subheading {
    color: rgba(255, 255, 255, 0.85);
  }

  @media (max-width: 767px) {
    .hero-banner {
      min-height: 60vh;
      padding: var(--space-3xl) var(--page-margin);
    }

    .hero-banner__heading {
      font-size: var(--text-3xl);
    }

    .hero-banner__subheading {
      font-size: var(--text-base);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.hero_banner.name",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:labels.background_image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:labels.overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 30,
      "unit": "%"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Smart living starts at home."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "t:labels.subheading",
      "default": "Premium kitchen and home essentials designed to simplify everyday living."
    },
    {
      "type": "header",
      "content": "t:labels.primary_cta"
    },
    {
      "type": "text",
      "id": "primary_cta_label",
      "label": "t:labels.button_label",
      "default": "Shop kitchen"
    },
    {
      "type": "url",
      "id": "primary_cta_url",
      "label": "t:labels.button_link"
    },
    {
      "type": "header",
      "content": "t:labels.secondary_cta"
    },
    {
      "type": "text",
      "id": "secondary_cta_label",
      "label": "t:labels.button_label",
      "default": "Shop cleaning"
    },
    {
      "type": "url",
      "id": "secondary_cta_url",
      "label": "t:labels.button_link"
    }
  ],
  "presets": [
    {
      "name": "t:sections.hero_banner.name"
    }
  ]
}
{% endschema %}
