<header class="header" id="site-header">
  <div class="header__inner">
    <a href="{{ routes.root_url }}" class="header__logo" aria-label="{{ shop.name }}">
      {% if section.settings.logo %}
        <img
          src="{{ section.settings.logo | image_url: width: 240 }}"
          alt="{{ shop.name }}"
          width="240"
          height="{{ 240 | divided_by: section.settings.logo.aspect_ratio | round }}"
          class="header__logo-image"
        >
      {% else %}
        <img
          src="{{ 'logo-intelligent-home.png' | asset_url }}"
          alt="{{ shop.name }}"
          width="180"
          height="90"
          class="header__logo-image"
        >
      {% endif %}
    </a>

    <nav class="header__nav" aria-label="{{ 'general.menu' | t }}">
      {% if section.settings.menu %}
        {% for link in section.settings.menu.links %}
          {% assign is_active = false %}
          {% if request.path == link.url %}
            {% assign is_active = true %}
          {% endif %}
          {% if link.url contains request.path %}
            {% if request.path != '/' %}
              {% assign is_active = true %}
            {% endif %}
          {% endif %}
          <a href="{{ link.url }}" class="header__nav-link {% if is_active %}header__nav-link--active{% endif %}">
            {{ link.title }}
          </a>
        {% endfor %}
      {% else %}
        <a href="/" class="header__nav-link {% if request.path == '/' %}header__nav-link--active{% endif %}">Home</a>
        <a href="/collections/kitchen" class="header__nav-link {% if request.path contains 'kitchen' %}header__nav-link--active{% endif %}">Kitchen</a>
        <a href="/collections/cleaning" class="header__nav-link {% if request.path contains 'cleaning' %}header__nav-link--active{% endif %}">Cleaning</a>
        <a href="/collections/bedroom" class="header__nav-link {% if request.path contains 'bedroom' %}header__nav-link--active{% endif %}">Bedroom</a>
        <a href="/collections/bathroom" class="header__nav-link {% if request.path contains 'bathroom' %}header__nav-link--active{% endif %}">Bathroom</a>
        <a href="/collections/living-room" class="header__nav-link {% if request.path contains 'living-room' %}header__nav-link--active{% endif %}">Living Room</a>
        <a href="/collections" class="header__nav-link {% if request.path == '/collections' %}header__nav-link--active{% endif %}">Collections</a>
      {% endif %}
    </nav>

    <div class="header__actions">
      <a href="{{ routes.search_url }}" class="header__action header__search-trigger" aria-label="{{ 'general.search' | t }}">
        {{ 'icon-search.svg' | inline_asset_content }}
      </a>

      {% if shop.customer_accounts_enabled %}
        <shopify-account menu="{{ section.settings.customer_account_menu }}" class="header__action">
          {{ 'icon-account.svg' | inline_asset_content }}
        </shopify-account>
      {% endif %}

      <a href="{{ routes.cart_url }}" class="header__action header__cart" aria-label="{{ 'general.cart' | t }}">
        {{ 'icon-cart.svg' | inline_asset_content }}
        {% if cart.item_count > 0 %}
          <span class="header__cart-badge">{{ cart.item_count }}</span>
        {% endif %}
      </a>

      <button
        class="header__hamburger"
        aria-label="{{ 'accessibility.open_menu' | t }}"
        aria-expanded="false"
        aria-controls="mobile-drawer"
        type="button"
      >
        <span class="header__hamburger-line"></span>
        <span class="header__hamburger-line"></span>
        <span class="header__hamburger-line"></span>
      </button>
    </div>
  </div>
</header>

{% comment %}
  Mobile drawer — full navigation structure.
  Uses primary menu + a secondary "utility" menu for support links.
  If no menus are assigned, shows sensible defaults.
{% endcomment %}
<div class="mobile-drawer" id="mobile-drawer" aria-hidden="true" scroll-lock>
  <div class="mobile-drawer__overlay"></div>
  <aside class="mobile-drawer__panel" role="dialog" aria-label="{{ 'general.menu' | t }}">
    <div class="mobile-drawer__header">
      <span class="mobile-drawer__title">{{ 'general.menu' | t }}</span>
      <button class="mobile-drawer__close" aria-label="{{ 'accessibility.close_menu' | t }}" type="button">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>

    <nav class="mobile-drawer__nav">
      {% comment %} Primary navigation with sub-links {% endcomment %}
      {% if section.settings.menu %}
        {% for link in section.settings.menu.links %}
          {% if link.links.size > 0 %}
            <div class="mobile-drawer__group">
              <button type="button" class="mobile-drawer__group-toggle" aria-expanded="false">
                <span>{{ link.title }}</span>
                <svg class="mobile-drawer__chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="6 9 12 15 18 9"/></svg>
              </button>
              <div class="mobile-drawer__submenu" aria-hidden="true">
                <a href="{{ link.url }}" class="mobile-drawer__sublink mobile-drawer__sublink--all">
                  {{ 'mobile_menu.view_all' | t }} {{ link.title }}
                </a>
                {% for child in link.links %}
                  <a href="{{ child.url }}" class="mobile-drawer__sublink">{{ child.title }}</a>
                {% endfor %}
              </div>
            </div>
          {% else %}
            <a href="{{ link.url }}" class="mobile-drawer__link">{{ link.title }}</a>
          {% endif %}
        {% endfor %}
      {% else %}
        {% comment %} Fallback navigation when no menu is assigned {% endcomment %}
        <a href="/" class="mobile-drawer__link">Home</a>

        <div class="mobile-drawer__group">
          <button type="button" class="mobile-drawer__group-toggle" aria-expanded="false">
            <span>Shop</span>
            <svg class="mobile-drawer__chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="mobile-drawer__submenu" aria-hidden="true">
            <a href="/collections/all" class="mobile-drawer__sublink mobile-drawer__sublink--all">View all products</a>
            <a href="/collections/kitchen" class="mobile-drawer__sublink">Kitchen</a>
            <a href="/collections/cleaning" class="mobile-drawer__sublink">Cleaning</a>
            <a href="/collections/bedroom" class="mobile-drawer__sublink">Bedroom</a>
            <a href="/collections/bathroom" class="mobile-drawer__sublink">Bathroom</a>
            <a href="/collections/living-room" class="mobile-drawer__sublink">Living Room</a>
            <a href="/collections/smart-home" class="mobile-drawer__sublink">Smart Home</a>
          </div>
        </div>

        <a href="/collections" class="mobile-drawer__link">Collections</a>
        <a href="/collections/new-arrivals" class="mobile-drawer__link">New Arrivals</a>
        <a href="/collections/best-sellers" class="mobile-drawer__link">Best Sellers</a>
      {% endif %}
    </nav>

    <div class="mobile-drawer__utility">
      {% if section.settings.drawer_menu %}
        {% for link in section.settings.drawer_menu.links %}
          <a href="{{ link.url }}" class="mobile-drawer__utility-link">{{ link.title }}</a>
        {% endfor %}
      {% else %}
        <a href="/pages/about" class="mobile-drawer__utility-link">{{ 'mobile_menu.about' | t }}</a>
        <a href="/pages/faq" class="mobile-drawer__utility-link">{{ 'mobile_menu.faq' | t }}</a>
        <a href="/pages/contact" class="mobile-drawer__utility-link">{{ 'mobile_menu.contact' | t }}</a>
        <a href="/pages/track-order" class="mobile-drawer__utility-link">{{ 'mobile_menu.track_order' | t }}</a>
      {% endif %}
    </div>

    <div class="mobile-drawer__footer">
      <a href="{{ routes.search_url }}" class="mobile-drawer__footer-link">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="9" cy="9" r="5.25"/><path stroke-linecap="round" d="m13 13 3.5 3.5"/></svg>
        {{ 'general.search' | t }}
      </a>
      {% if shop.customer_accounts_enabled %}
        <a href="{{ routes.account_url }}" class="mobile-drawer__footer-link">
          <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="10" cy="6.5" r="2.75"/><path stroke-linecap="round" stroke-linejoin="round" d="m5.172 14.591-.437.786a.588.588 0 0 0 .514.873h9.502a.588.588 0 0 0 .514-.873l-.437-.786a5.523 5.523 0 0 0-9.656 0"/></svg>
          {{ 'general.account' | t }}
        </a>
      {% endif %}
    </div>
  </aside>
</div>

{% stylesheet %}
  /* ═══════════════════════════════════════════════════════
     STICKY HEADER — Premium
     - Fixed to top
     - Backdrop blur (frosted glass)
     - Transparent at top → solid after 40px
     - Shrinks 80px → 68px
     - Hides on scroll down, shows on scroll up
     ═══════════════════════════════════════════════════════ */

  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    box-shadow: none;
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  /* Solid state with backdrop blur after scrolling */
  .header--solid {
    background-color: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 1px 16px rgba(0, 0, 0, 0.04);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xl);
    height: 80px;
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 var(--page-margin);
    transition: height 0.25s ease;
  }

  .header--shrink .header__inner {
    height: 68px;
  }

  /* Logo */
  .header__logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
  }

  .header__logo-image {
    height: 48px;
    width: auto;
    max-width: 180px;
    object-fit: contain;
    transition: height 0.25s ease;
  }

  .header--shrink .header__logo-image {
    height: 40px;
  }

  /* Navigation */
  .header__nav {
    display: flex;
    gap: var(--space-xl);
    align-items: center;
  }

  .header__nav-link {
    position: relative;
    font-family: var(--font-body-family);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    color: var(--color-foreground);
    letter-spacing: 0.02em;
    white-space: nowrap;
    padding: var(--space-sm) 0;
    transition: color 0.25s ease;
  }

  .header__nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 0;
    height: 2px;
    background-color: var(--color-primary);
    border-radius: 1px;
    transition: width 0.3s ease, left 0.3s ease;
  }

  .header__nav-link:hover {
    color: var(--color-primary);
  }

  .header__nav-link:hover::after {
    width: 100%;
    left: 0;
  }

  /* Active page indicator */
  .header__nav-link--active {
    color: var(--color-primary);
  }

  .header__nav-link--active::after {
    width: 100%;
    left: 0;
  }

  /* Action icons */
  .header__actions {
    display: flex;
    gap: var(--space-xs);
    align-items: center;
    flex-shrink: 0;
  }

  .header__action {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    text-decoration: none;
    color: var(--color-foreground);
    transition: background-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }

  .header__action:hover {
    background-color: var(--color-surface-alt);
    color: var(--color-primary);
    transform: translateY(-1px);
  }

  .header__actions svg {
    width: 20px;
    height: 20px;
  }

  .header__cart-badge {
    position: absolute;
    top: 4px;
    right: 4px;
    min-width: 16px;
    height: 16px;
    background-color: var(--color-primary);
    color: white;
    font-size: 0.6rem;
    font-weight: 600;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 4px;
    transition: transform 0.3s ease;
  }

  /* Hamburger */
  .header__hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    padding: 10px;
    background: none;
    border: none;
    cursor: pointer;
    border-radius: 50%;
    transition: background-color 0.2s ease;
  }

  .header__hamburger:hover {
    background-color: var(--color-surface-alt);
  }

  .header__hamburger-line {
    display: block;
    width: 20px;
    height: 2px;
    background-color: var(--color-foreground);
    border-radius: 1px;
    transition: transform 0.3s ease, opacity 0.3s ease;
    transform-origin: center;
  }

  .header__hamburger[aria-expanded="true"] .header__hamburger-line:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .header__hamburger[aria-expanded="true"] .header__hamburger-line:nth-child(2) {
    opacity: 0;
  }
  .header__hamburger[aria-expanded="true"] .header__hamburger-line:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* ═══════════════════════════════════════════════════════
     MOBILE DRAWER — Full Navigation
     ═══════════════════════════════════════════════════════ */
  .mobile-drawer {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 200;
  }

  .mobile-drawer[open] {
    display: block;
  }

  .mobile-drawer__overlay {
    position: absolute;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    opacity: 0;
    transition: opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .mobile-drawer[open] .mobile-drawer__overlay {
    opacity: 1;
  }

  .mobile-drawer__panel {
    position: absolute;
    top: 0;
    left: 0;
    width: min(340px, 88vw);
    height: 100%;
    background-color: var(--color-surface);
    transform: translateX(-100%);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    box-shadow: 4px 0 32px rgba(0, 0, 0, 0.12);
  }

  .mobile-drawer[open] .mobile-drawer__panel {
    transform: translateX(0);
  }

  .mobile-drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-lg) var(--space-xl);
    border-bottom: 1px solid var(--color-border);
    flex-shrink: 0;
  }

  .mobile-drawer__title {
    font-family: var(--font-heading-family);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-foreground);
  }

  .mobile-drawer__close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-foreground);
    border-radius: 50%;
    transition: background-color 0.2s ease;
  }

  .mobile-drawer__close:hover {
    background-color: var(--color-surface-alt);
  }

  /* Main nav links */
  .mobile-drawer__nav {
    display: flex;
    flex-direction: column;
    padding: var(--space-sm) 0;
    flex: 1;
  }

  .mobile-drawer__link {
    display: block;
    padding: 14px var(--space-xl);
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--color-foreground);
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .mobile-drawer__link:hover {
    background-color: var(--color-surface-alt);
    color: var(--color-primary);
  }

  /* Collapsible sub-menu groups */
  .mobile-drawer__group {
    border-bottom: 1px solid var(--color-border);
  }

  .mobile-drawer__group:first-child {
    border-top: none;
  }

  .mobile-drawer__group-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 14px var(--space-xl);
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-foreground);
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    transition: background-color 0.2s ease;
  }

  .mobile-drawer__group-toggle:hover {
    background-color: var(--color-surface-alt);
  }

  .mobile-drawer__chevron {
    transition: transform 0.25s ease;
    color: var(--color-secondary);
  }

  .mobile-drawer__group-toggle[aria-expanded="true"] .mobile-drawer__chevron {
    transform: rotate(180deg);
  }

  .mobile-drawer__submenu {
    display: none;
    padding: 0 0 var(--space-sm);
  }

  .mobile-drawer__submenu[aria-hidden="false"] {
    display: block;
  }

  .mobile-drawer__sublink {
    display: block;
    padding: 10px var(--space-xl) 10px calc(var(--space-xl) + 16px);
    font-size: var(--text-sm);
    color: var(--color-secondary);
    text-decoration: none;
    transition: color 0.2s ease, background-color 0.2s ease;
  }

  .mobile-drawer__sublink:hover {
    color: var(--color-primary);
    background-color: var(--color-surface-alt);
  }

  .mobile-drawer__sublink--all {
    color: var(--color-primary);
    font-weight: 500;
  }

  /* Utility links section */
  .mobile-drawer__utility {
    border-top: 1px solid var(--color-border);
    padding: var(--space-md) 0;
  }

  .mobile-drawer__utility-link {
    display: block;
    padding: 10px var(--space-xl);
    font-size: var(--text-sm);
    color: var(--color-secondary);
    text-decoration: none;
    transition: color 0.2s ease, background-color 0.2s ease;
  }

  .mobile-drawer__utility-link:hover {
    color: var(--color-primary);
    background-color: var(--color-surface-alt);
  }

  /* Footer of drawer */
  .mobile-drawer__footer {
    border-top: 1px solid var(--color-border);
    padding: var(--space-md) var(--space-xl);
    display: flex;
    gap: var(--space-lg);
    flex-shrink: 0;
  }

  .mobile-drawer__footer-link {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: var(--text-sm);
    color: var(--color-secondary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .mobile-drawer__footer-link:hover {
    color: var(--color-primary);
  }

  .mobile-drawer__footer-link svg {
    flex-shrink: 0;
  }

  /* ═══════════════════════════════════════════════════════
     RESPONSIVE
     ═══════════════════════════════════════════════════════ */
  @media (max-width: 767px) {
    .header__nav {
      display: none;
    }

    .header__hamburger {
      display: flex;
    }

    .header__logo-image {
      height: 36px;
      max-width: 140px;
    }

    .header__inner {
      height: 64px;
    }

    .header--shrink .header__inner {
      height: 56px;
    }

    .header--shrink .header__logo-image {
      height: 30px;
    }
  }

  /* ═══════════════════════════════════════════════════════
     REDUCED MOTION
     ═══════════════════════════════════════════════════════ */
  @media (prefers-reduced-motion: reduce) {
    .header,
    .header__inner,
    .header__logo-image,
    .header__nav-link::after,
    .mobile-drawer__panel,
    .mobile-drawer__overlay,
    .mobile-drawer__link,
    .mobile-drawer__chevron {
      transition-duration: 0.01ms !important;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function() {
    var hamburger = document.querySelector('.header__hamburger');
    var drawer = document.getElementById('mobile-drawer');
    if (!hamburger || !drawer) return;

    var overlay = drawer.querySelector('.mobile-drawer__overlay');
    var closeBtn = drawer.querySelector('.mobile-drawer__close');

    function openDrawer() {
      drawer.setAttribute('open', '');
      drawer.removeAttribute('aria-hidden');
      hamburger.setAttribute('aria-expanded', 'true');
      document.documentElement.style.overflow = 'hidden';
    }

    function closeDrawer() {
      drawer.removeAttribute('open');
      drawer.setAttribute('aria-hidden', 'true');
      hamburger.setAttribute('aria-expanded', 'false');
      document.documentElement.style.overflow = '';
    }

    hamburger.addEventListener('click', openDrawer);
    closeBtn.addEventListener('click', closeDrawer);
    overlay.addEventListener('click', closeDrawer);

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && drawer.hasAttribute('open')) {
        closeDrawer();
      }
    });

    // Collapsible sub-menus
    var toggles = drawer.querySelectorAll('.mobile-drawer__group-toggle');
    toggles.forEach(function(toggle) {
      toggle.addEventListener('click', function() {
        var expanded = this.getAttribute('aria-expanded') === 'true';
        var submenu = this.nextElementSibling;

        this.setAttribute('aria-expanded', !expanded);
        submenu.setAttribute('aria-hidden', expanded);
      });
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:labels.logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "info": "t:labels.menu_info"
    },
    {
      "type": "link_list",
      "id": "drawer_menu",
      "label": "t:labels.drawer_menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    }
  ]
}
{% endschema %}
