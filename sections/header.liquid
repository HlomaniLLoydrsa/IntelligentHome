<header class="header" id="site-header">
  <div class="header__inner">
    <a href="{{ routes.root_url }}" class="header__logo" aria-label="{{ shop.name }}">
      {% if section.settings.logo %}
        <img
          src="{{ section.settings.logo | image_url: width: 240 }}"
          alt="{{ shop.name }}"
          width="240"
          height="{{ 240 | divided_by: section.settings.logo.aspect_ratio | round }}"
          class="header__logo-image"
        >
      {% else %}
        <img
          src="{{ 'logo-intelligent-home.png' | asset_url }}"
          alt="{{ shop.name }}"
          width="180"
          height="90"
          class="header__logo-image"
        >
      {% endif %}
    </a>

    <nav class="header__nav" aria-label="{{ 'general.menu' | t }}">
      {% for link in section.settings.menu.links %}
        <a href="{{ link.url }}" class="header__nav-link">{{ link.title }}</a>
      {% endfor %}
    </nav>

    <div class="header__actions">
      <a href="{{ routes.search_url }}" class="header__action" aria-label="{{ 'general.search' | t }}">
        {{ 'icon-search.svg' | inline_asset_content }}
      </a>

      {% if shop.customer_accounts_enabled %}
        <shopify-account menu="{{ section.settings.customer_account_menu }}" class="header__action">
          {{ 'icon-account.svg' | inline_asset_content }}
        </shopify-account>
      {% endif %}

      <a href="{{ routes.cart_url }}" class="header__action header__cart" aria-label="{{ 'general.cart' | t }}">
        {{ 'icon-cart.svg' | inline_asset_content }}
        {% if cart.item_count > 0 %}
          <span class="header__cart-badge">{{ cart.item_count }}</span>
        {% endif %}
      </a>

      <button
        class="header__hamburger"
        aria-label="{{ 'accessibility.open_menu' | t }}"
        aria-expanded="false"
        aria-controls="mobile-drawer"
        type="button"
      >
        <span class="header__hamburger-line"></span>
        <span class="header__hamburger-line"></span>
        <span class="header__hamburger-line"></span>
      </button>
    </div>
  </div>
</header>

<div class="mobile-drawer" id="mobile-drawer" aria-hidden="true" scroll-lock>
  <div class="mobile-drawer__overlay"></div>
  <aside class="mobile-drawer__panel" role="dialog" aria-label="{{ 'general.menu' | t }}">
    <div class="mobile-drawer__header">
      <span class="mobile-drawer__title">{{ 'general.menu' | t }}</span>
      <button class="mobile-drawer__close" aria-label="{{ 'accessibility.close_menu' | t }}" type="button">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <nav class="mobile-drawer__nav">
      {% for link in section.settings.menu.links %}
        <a href="{{ link.url }}" class="mobile-drawer__link">{{ link.title }}</a>
      {% endfor %}
    </nav>
    <div class="mobile-drawer__footer">
      <a href="{{ routes.search_url }}" class="mobile-drawer__link">{{ 'general.search' | t }}</a>
      {% if shop.customer_accounts_enabled %}
        <a href="{{ routes.account_url }}" class="mobile-drawer__link">{{ 'general.account' | t }}</a>
      {% endif %}
    </div>
  </aside>
</div>

{% stylesheet %}
  /* ═══════════════════════════════════════════════════════
     STICKY HEADER
     - Fixed to top, always visible
     - Transparent at top of page (via .header--transparent)
     - Transitions to solid white after 40px scroll
     - Shrinks from 80px → 68px
     - All transitions 250ms ease
     ═══════════════════════════════════════════════════════ */

  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background-color: rgba(255, 255, 255, 0);
    border-bottom: 1px solid transparent;
    box-shadow: none;
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  /* Solid state — after scrolling 40px */
  .header--solid {
    background-color: rgba(255, 255, 255, 0.98);
    border-bottom-color: var(--color-border);
    box-shadow: 0 1px 12px rgba(0, 0, 0, 0.06);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xl);
    height: 80px;
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 var(--page-margin);
    transition: height 0.25s ease;
  }

  /* Shrunk state */
  .header--shrink .header__inner {
    height: 68px;
  }

  /* Logo */
  .header__logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
  }

  .header__logo-image {
    height: 52px;
    width: auto;
    max-width: 180px;
    object-fit: contain;
    transition: height 0.25s ease, transform 0.25s ease;
  }

  .header--shrink .header__logo-image {
    height: 42px;
  }

  /* Navigation */
  .header__nav {
    display: flex;
    gap: var(--space-xl);
    align-items: center;
  }

  .header__nav-link {
    position: relative;
    font-family: var(--font-body-family);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    color: var(--color-foreground);
    letter-spacing: 0.02em;
    white-space: nowrap;
    padding: var(--space-sm) 0;
    transition: color 0.25s ease;
  }

  .header__nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 0;
    height: 2px;
    background-color: var(--color-primary);
    border-radius: 1px;
    transition: width 0.3s ease, left 0.3s ease;
  }

  .header__nav-link:hover {
    color: var(--color-primary);
  }

  .header__nav-link:hover::after {
    width: 100%;
    left: 0;
  }

  /* Action icons */
  .header__actions {
    display: flex;
    gap: var(--space-xs);
    align-items: center;
    flex-shrink: 0;
  }

  .header__action {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    text-decoration: none;
    color: var(--color-foreground);
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .header__action:hover {
    background-color: var(--color-surface-alt);
    color: var(--color-primary);
  }

  .header__actions svg {
    width: 20px;
    height: 20px;
  }

  /* Cart badge */
  .header__cart-badge {
    position: absolute;
    top: 4px;
    right: 4px;
    min-width: 16px;
    height: 16px;
    background-color: var(--color-primary);
    color: white;
    font-size: 0.6rem;
    font-weight: 600;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 4px;
    transition: transform 0.3s ease;
  }

  /* Hamburger */
  .header__hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    padding: 10px;
    background: none;
    border: none;
    cursor: pointer;
    border-radius: 50%;
    transition: background-color 0.2s ease;
  }

  .header__hamburger:hover {
    background-color: var(--color-surface-alt);
  }

  .header__hamburger-line {
    display: block;
    width: 20px;
    height: 2px;
    background-color: var(--color-foreground);
    border-radius: 1px;
    transition: transform 0.3s ease, opacity 0.3s ease;
    transform-origin: center;
  }

  /* Hamburger → X animation when drawer is open */
  .header__hamburger[aria-expanded="true"] .header__hamburger-line:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .header__hamburger[aria-expanded="true"] .header__hamburger-line:nth-child(2) {
    opacity: 0;
  }

  .header__hamburger[aria-expanded="true"] .header__hamburger-line:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* ═══════════════════════════════════════════════════════
     SPACER — prevents fixed header from covering content
     ═══════════════════════════════════════════════════════ */
  .header + * {
    /* Handled by body padding-top below */
  }

  /* ═══════════════════════════════════════════════════════
     MOBILE DRAWER
     ═══════════════════════════════════════════════════════ */
  .mobile-drawer {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 200;
  }

  .mobile-drawer[open] {
    display: block;
  }

  .mobile-drawer__overlay {
    position: absolute;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.5);
    opacity: 0;
    transition: opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .mobile-drawer[open] .mobile-drawer__overlay {
    opacity: 1;
  }

  .mobile-drawer__panel {
    position: absolute;
    top: 0;
    left: 0;
    width: min(320px, 85vw);
    height: 100%;
    background-color: var(--color-surface);
    transform: translateX(-100%);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    box-shadow: 4px 0 24px rgba(0, 0, 0, 0.1);
  }

  .mobile-drawer[open] .mobile-drawer__panel {
    transform: translateX(0);
  }

  .mobile-drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-lg) var(--space-xl);
    border-bottom: 1px solid var(--color-border);
  }

  .mobile-drawer__title {
    font-family: var(--font-heading-family);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-foreground);
  }

  .mobile-drawer__close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-foreground);
    border-radius: 50%;
    transition: background-color 0.2s ease;
  }

  .mobile-drawer__close:hover {
    background-color: var(--color-surface-alt);
  }

  .mobile-drawer__nav {
    display: flex;
    flex-direction: column;
    padding: var(--space-md) 0;
    flex: 1;
  }

  .mobile-drawer__link {
    display: block;
    padding: var(--space-md) var(--space-xl);
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--color-foreground);
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease;
    opacity: 0;
    transform: translateX(-10px);
  }

  .mobile-drawer[open] .mobile-drawer__link {
    opacity: 1;
    transform: translateX(0);
    transition: opacity 0.3s ease, transform 0.3s ease, background-color 0.2s ease, color 0.2s ease;
  }

  /* Stagger menu links */
  .mobile-drawer[open] .mobile-drawer__link:nth-child(1) { transition-delay: 0.05s; }
  .mobile-drawer[open] .mobile-drawer__link:nth-child(2) { transition-delay: 0.1s; }
  .mobile-drawer[open] .mobile-drawer__link:nth-child(3) { transition-delay: 0.15s; }
  .mobile-drawer[open] .mobile-drawer__link:nth-child(4) { transition-delay: 0.2s; }
  .mobile-drawer[open] .mobile-drawer__link:nth-child(5) { transition-delay: 0.25s; }
  .mobile-drawer[open] .mobile-drawer__link:nth-child(6) { transition-delay: 0.3s; }
  .mobile-drawer[open] .mobile-drawer__link:nth-child(7) { transition-delay: 0.35s; }
  .mobile-drawer[open] .mobile-drawer__link:nth-child(8) { transition-delay: 0.4s; }

  .mobile-drawer__link:hover {
    background-color: var(--color-surface-alt);
    color: var(--color-primary);
  }

  .mobile-drawer__footer {
    border-top: 1px solid var(--color-border);
    padding: var(--space-md) 0;
  }

  /* ═══════════════════════════════════════════════════════
     RESPONSIVE
     ═══════════════════════════════════════════════════════ */
  @media (max-width: 767px) {
    .header__nav {
      display: none;
    }

    .header__hamburger {
      display: flex;
    }

    .header__logo-image {
      height: 36px;
      max-width: 140px;
    }

    .header__inner {
      height: 64px;
    }

    .header--shrink .header__inner {
      height: 56px;
    }

    .header--shrink .header__logo-image {
      height: 30px;
    }
  }

  /* ═══════════════════════════════════════════════════════
     REDUCED MOTION
     ═══════════════════════════════════════════════════════ */
  @media (prefers-reduced-motion: reduce) {
    .header,
    .header__inner,
    .header__logo-image,
    .header__nav-link::after,
    .mobile-drawer__panel,
    .mobile-drawer__overlay,
    .mobile-drawer__link {
      transition-duration: 0.01ms !important;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function() {
    var hamburger = document.querySelector('.header__hamburger');
    var drawer = document.getElementById('mobile-drawer');
    if (!hamburger || !drawer) return;

    var overlay = drawer.querySelector('.mobile-drawer__overlay');
    var closeBtn = drawer.querySelector('.mobile-drawer__close');

    function openDrawer() {
      drawer.setAttribute('open', '');
      drawer.removeAttribute('aria-hidden');
      hamburger.setAttribute('aria-expanded', 'true');
      document.documentElement.style.overflow = 'hidden';
    }

    function closeDrawer() {
      drawer.removeAttribute('open');
      drawer.setAttribute('aria-hidden', 'true');
      hamburger.setAttribute('aria-expanded', 'false');
      document.documentElement.style.overflow = '';
    }

    hamburger.addEventListener('click', openDrawer);
    closeBtn.addEventListener('click', closeDrawer);
    overlay.addEventListener('click', closeDrawer);

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && drawer.hasAttribute('open')) {
        closeDrawer();
      }
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:labels.logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    }
  ]
}
{% endschema %}
