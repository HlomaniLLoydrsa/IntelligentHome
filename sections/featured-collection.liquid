<section class="featured-collection">
  <div class="featured-collection__header">
    {% if section.settings.heading != blank %}
      <h2 class="featured-collection__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    {% if section.settings.collection %}
      <a href="{{ section.settings.collection.url }}" class="featured-collection__view-all">
        {{ 'sections.featured_collection.view_all' | t }}
      </a>
    {% endif %}
  </div>

  {% if section.settings.collection %}
    <div class="featured-collection__grid">
      {% for product in section.settings.collection.products limit: section.settings.products_to_show %}
        {% render 'product-card', product: product, lazy: true %}
      {% endfor %}
    </div>
  {% else %}
    <div class="featured-collection__grid">
      {% for i in (1..4) %}
        <article class="product-card">
          <div class="product-card__link">
            <div class="product-card__image-wrapper">
              <div class="product-card__placeholder">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            </div>
            <div class="product-card__info">
              <h3 class="product-card__title">{{ 'sections.featured_collection.example_product' | t }}</h3>
              <p class="product-card__price">{{ 2999 | money }}</p>
            </div>
          </div>
        </article>
      {% endfor %}
    </div>
  {% endif %}
</section>

{% stylesheet %}
  .featured-collection {
    padding: var(--space-4xl) 0;
  }

  .featured-collection__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
    margin-bottom: var(--space-2xl);
  }

  .featured-collection__heading {
    font-size: var(--text-3xl);
    margin: 0;
    color: var(--color-foreground);
  }

  .featured-collection__view-all {
    font-size: var(--text-sm);
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 500;
    white-space: nowrap;
  }

  .featured-collection__view-all:hover {
    color: var(--color-accent);
  }

  .featured-collection__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-xl);
  }

  @media (max-width: 1023px) {
    .featured-collection__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 767px) {
    .featured-collection {
      padding: var(--space-3xl) 0;
    }

    .featured-collection__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-md);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.featured_collection.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Best sellers"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:labels.collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:labels.products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured_collection.name"
    }
  ]
}
{% endschema %}
