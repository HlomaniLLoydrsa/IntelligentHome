<section class="newsletter" data-animate>
  <div class="newsletter__content">
    {% if section.settings.heading != blank %}
      <h2 class="newsletter__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    {% if section.settings.description != blank %}
      <p class="newsletter__description">{{ section.settings.description | escape }}</p>
    {% endif %}

    {% form 'customer', class: 'newsletter__form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="newsletter__input-group">
        <label for="newsletter-email" class="visually-hidden">{{ 'sections.newsletter.email_label' | t }}</label>
        <input
          type="email"
          name="contact[email]"
          id="newsletter-email"
          placeholder="{{ 'sections.newsletter.email_placeholder' | t }}"
          required
          autocomplete="email"
          class="newsletter__input"
        >
        {% render 'button', label: section.settings.button_label, type: 'submit', style: 'primary' %}
      </div>

      {% if form.posted_successfully? %}
        <p class="newsletter__success">{{ 'sections.newsletter.success' | t }}</p>
      {% endif %}

      {% if form.errors %}
        <p class="newsletter__error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
      {% endif %}
    {% endform %}

    {% if section.settings.disclaimer != blank %}
      <p class="newsletter__disclaimer">{{ section.settings.disclaimer | escape }}</p>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .newsletter {
    padding: var(--space-4xl) 0;
    text-align: center;
  }

  .newsletter__content {
    max-width: 32rem;
    margin: 0 auto;
  }

  .newsletter__heading {
    font-size: var(--text-2xl);
    margin: 0;
    color: var(--color-foreground);
  }

  .newsletter__description {
    font-size: var(--text-base);
    color: var(--color-secondary);
    margin: var(--space-sm) 0 0;
    line-height: 1.5;
  }

  .newsletter__form {
    margin-top: var(--space-xl);
  }

  .newsletter__input-group {
    display: flex;
    gap: var(--space-sm);
  }

  .newsletter__input {
    flex: 1;
    min-width: 0;
  }

  .newsletter__success {
    color: var(--color-primary);
    font-size: var(--text-sm);
    margin-top: var(--space-sm);
  }

  .newsletter__error {
    color: #DC2626;
    font-size: var(--text-sm);
    margin-top: var(--space-sm);
  }

  .newsletter__disclaimer {
    font-size: var(--text-xs);
    color: var(--color-secondary);
    margin-top: var(--space-md);
  }

  @media (max-width: 767px) {
    .newsletter {
      padding: var(--space-3xl) 0;
    }

    .newsletter__input-group {
      flex-direction: column;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.newsletter.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Stay in the loop"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:labels.description",
      "default": "Subscribe for new arrivals, home tips, and exclusive offers."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "disclaimer",
      "label": "t:labels.disclaimer",
      "default": "We respect your privacy. Unsubscribe at any time."
    }
  ],
  "presets": [
    {
      "name": "t:sections.newsletter.name"
    }
  ]
}
{% endschema %}
