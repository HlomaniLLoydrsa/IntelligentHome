<section class="collections-page">
  <h1 class="collections-page__title">{{ 'collections.title' | t }}</h1>

  <div class="collections-page__grid">
    {% for collection in collections %}
      {% if collection.handle != 'all' %}
        <a href="{{ collection.url }}" class="collections-page__card">
          <div class="collections-page__card-image">
            {% if collection.image %}
              <img
                src="{{ collection.image | image_url: width: 600 }}"
                alt="{{ collection.title | escape }}"
                width="600"
                height="{{ 600 | divided_by: collection.image.aspect_ratio | round }}"
                loading="lazy"
              >
            {% else %}
              <div class="collections-page__placeholder">
                {{ 'collection-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
          <div class="collections-page__card-info">
            <h2 class="collections-page__card-title">{{ collection.title | escape }}</h2>
            <p class="collections-page__card-count">{{ collection.products_count }} {{ 'collections.products_label' | t }}</p>
          </div>
        </a>
      {% endif %}
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .collections-page {
    padding: var(--space-2xl) 0 var(--space-4xl);
  }

  .collections-page__title {
    font-size: var(--text-4xl);
    margin: 0 0 var(--space-2xl);
    color: var(--color-foreground);
  }

  .collections-page__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-xl);
  }

  .collections-page__card {
    display: block;
    text-decoration: none;
    color: inherit;
    border-radius: var(--border-radius);
    overflow: hidden;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }

  .collections-page__card:hover {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    transform: translateY(-2px);
  }

  .collections-page__card-image {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background-color: var(--color-surface-alt);
  }

  .collections-page__card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .collections-page__card:hover img {
    transform: scale(1.03);
  }

  .collections-page__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-2xl);
  }

  .collections-page__placeholder svg {
    width: 40%;
    height: auto;
    opacity: 0.3;
  }

  .collections-page__card-info {
    padding: var(--space-lg);
  }

  .collections-page__card-title {
    font-family: var(--font-heading-family);
    font-size: var(--text-lg);
    font-weight: 600;
    margin: 0;
    color: var(--color-foreground);
  }

  .collections-page__card-count {
    font-size: var(--text-sm);
    color: var(--color-secondary);
    margin: var(--space-xs) 0 0;
  }

  @media (max-width: 1023px) {
    .collections-page__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 767px) {
    .collections-page {
      padding: var(--space-xl) 0 var(--space-3xl);
    }

    .collections-page__title {
      font-size: var(--text-3xl);
    }

    .collections-page__grid {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collections",
  "settings": []
}
{% endschema %}
