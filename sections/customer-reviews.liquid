<section class="customer-reviews full-width" style="background-color: var(--color-surface-brand)">
  <div class="customer-reviews__inner">
    {% if section.settings.heading != blank %}
      <h2 class="customer-reviews__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    <div class="customer-reviews__grid">
      {% for block in section.blocks %}
        <blockquote class="review-card" {{ block.shopify_attributes }}>
          <div class="review-card__stars" aria-label="{{ block.settings.rating }} {{ 'sections.customer_reviews.out_of_5' | t }}">
            {% for i in (1..5) %}
              {% if i <= block.settings.rating %}
                <span class="review-card__star review-card__star--filled" aria-hidden="true">★</span>
              {% else %}
                <span class="review-card__star" aria-hidden="true">☆</span>
              {% endif %}
            {% endfor %}
          </div>
          {% if block.settings.text != blank %}
            <p class="review-card__text">{{ block.settings.text | escape }}</p>
          {% endif %}
          {% if block.settings.author != blank %}
            <cite class="review-card__author">— {{ block.settings.author | escape }}</cite>
          {% endif %}
        </blockquote>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .customer-reviews {
    padding: var(--space-4xl) var(--page-margin);
  }

  .customer-reviews__inner {
    max-width: var(--page-width);
    margin: 0 auto;
  }

  .customer-reviews__heading {
    text-align: center;
    font-size: var(--text-3xl);
    margin: 0 0 var(--space-2xl);
    color: var(--color-foreground);
  }

  .customer-reviews__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-xl);
  }

  .review-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius);
    padding: var(--space-xl);
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .review-card__stars {
    display: flex;
    gap: 2px;
    font-size: var(--text-lg);
  }

  .review-card__star--filled {
    color: var(--color-accent);
  }

  .review-card__star {
    color: var(--color-border);
  }

  .review-card__text {
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--color-foreground);
    margin: 0;
    font-style: italic;
  }

  .review-card__author {
    font-size: var(--text-sm);
    color: var(--color-secondary);
    font-style: normal;
    font-weight: 500;
  }

  @media (max-width: 1023px) {
    .customer-reviews__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 767px) {
    .customer-reviews {
      padding: var(--space-3xl) var(--page-margin);
    }

    .customer-reviews__grid {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.customer_reviews.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "What our customers say"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "t:sections.customer_reviews.review",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "t:labels.rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:labels.review_text",
          "default": "Beautiful quality products. Everything arrived well packaged and exactly as described."
        },
        {
          "type": "text",
          "id": "author",
          "label": "t:labels.author",
          "default": "Happy Customer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.customer_reviews.name",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "rating": 5,
            "text": "The kitchen accessories are stunning. Premium feel and beautifully designed.",
            "author": "Sarah M."
          }
        },
        {
          "type": "review",
          "settings": {
            "rating": 5,
            "text": "Fast shipping and excellent quality. These cleaning tools make daily chores so much easier.",
            "author": "James R."
          }
        },
        {
          "type": "review",
          "settings": {
            "rating": 5,
            "text": "Love everything I've ordered. The attention to detail is impressive for the price.",
            "author": "Emily T."
          }
        }
      ]
    }
  ]
}
{% endschema %}
