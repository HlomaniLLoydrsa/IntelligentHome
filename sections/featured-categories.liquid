<section class="featured-categories">
  {% if section.settings.heading != blank %}
    <h2 class="featured-categories__heading">{{ section.settings.heading | escape }}</h2>
  {% endif %}

  {% if section.settings.description != blank %}
    <p class="featured-categories__description">{{ section.settings.description | escape }}</p>
  {% endif %}

  <div class="featured-categories__grid">
    {% content_for 'blocks' %}
  </div>
</section>

{% stylesheet %}
  .featured-categories {
    padding: var(--space-4xl) 0;
  }

  .featured-categories__heading {
    text-align: center;
    font-size: var(--text-3xl);
    margin: 0;
    color: var(--color-foreground);
  }

  .featured-categories__description {
    text-align: center;
    font-size: var(--text-base);
    color: var(--color-secondary);
    margin: var(--space-sm) auto 0;
    max-width: 36rem;
  }

  .featured-categories__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-xl);
    margin-top: var(--space-2xl);
  }

  @media (max-width: 767px) {
    .featured-categories {
      padding: var(--space-3xl) 0;
    }

    .featured-categories__grid {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.featured_categories.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Shop by category"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:labels.description"
    }
  ],
  "blocks": [
    {
      "type": "category-card"
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured_categories.name",
      "blocks": [
        {
          "type": "category-card",
          "settings": {
            "title": "Kitchen accessories"
          }
        },
        {
          "type": "category-card",
          "settings": {
            "title": "Kitchen cleaning"
          }
        }
      ]
    }
  ]
}
{% endschema %}
