<section class="value-propositions full-width" data-animate style="background-color: var(--color-surface-alt)">
  {% if section.settings.heading != blank %}
    <h2 class="value-propositions__heading">{{ section.settings.heading | escape }}</h2>
  {% endif %}

  <div class="value-propositions__grid">
    {% content_for 'blocks' %}
  </div>
</section>

{% stylesheet %}
  .value-propositions {
    padding: var(--space-4xl) var(--page-margin);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .value-propositions__heading {
    text-align: center;
    font-size: var(--text-2xl);
    margin: 0 0 var(--space-2xl);
    color: var(--color-foreground);
  }

  .value-propositions__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-xl);
    width: 100%;
    max-width: var(--page-width);
  }

  @media (max-width: 1023px) {
    .value-propositions__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 767px) {
    .value-propositions {
      padding: var(--space-3xl) var(--page-margin);
    }

    .value-propositions__grid {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.value_propositions.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Why choose Intelligent Home"
    }
  ],
  "blocks": [
    {
      "type": "value-item"
    }
  ],
  "presets": [
    {
      "name": "t:sections.value_propositions.name",
      "blocks": [
        {
          "type": "value-item",
          "settings": {
            "icon": "✦",
            "title": "Premium quality",
            "description": "Carefully selected materials and thoughtful design in every product."
          }
        },
        {
          "type": "value-item",
          "settings": {
            "icon": "⚡",
            "title": "Fast shipping",
            "description": "Quick and reliable delivery straight to your door."
          }
        },
        {
          "type": "value-item",
          "settings": {
            "icon": "🔒",
            "title": "Secure checkout",
            "description": "Your payment and personal information are always protected."
          }
        },
        {
          "type": "value-item",
          "settings": {
            "icon": "↩",
            "title": "Easy returns",
            "description": "Not satisfied? Return within 30 days, no questions asked."
          }
        }
      ]
    }
  ]
}
{% endschema %}
