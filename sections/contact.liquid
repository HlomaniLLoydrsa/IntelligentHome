<section class="contact-page">
  <div class="contact-page__header">
    <h1 class="contact-page__title">{{ section.settings.heading | default: 'sections.contact.title' | t }}</h1>
    {% if section.settings.description != blank %}
      <p class="contact-page__description">{{ section.settings.description | escape }}</p>
    {% endif %}
  </div>

  <div class="contact-page__grid">
    <div class="contact-page__form-wrapper">
      <h2 class="contact-page__form-title">{{ 'sections.contact.send_message' | t }}</h2>
      {% form 'contact', class: 'contact-page__form' %}
        {% if form.posted_successfully? %}
          <div class="contact-page__success">
            <p>{{ 'sections.contact.success' | t }}</p>
          </div>
        {% endif %}

        {% if form.errors %}
          <div class="contact-page__errors">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <div class="contact-page__field">
          <label for="contact-name">{{ 'sections.contact.name' | t }}</label>
          <input type="text" id="contact-name" name="contact[name]" required autocomplete="name">
        </div>

        <div class="contact-page__field">
          <label for="contact-email">{{ 'sections.contact.email' | t }}</label>
          <input type="email" id="contact-email" name="contact[email]" required autocomplete="email">
        </div>

        <div class="contact-page__field">
          <label for="contact-phone">{{ 'sections.contact.phone' | t }}</label>
          <input type="tel" id="contact-phone" name="contact[phone]" autocomplete="tel">
        </div>

        <div class="contact-page__field">
          <label for="contact-message">{{ 'sections.contact.message' | t }}</label>
          <textarea id="contact-message" name="contact[body]" rows="5" required></textarea>
        </div>

        {% render 'button', label: 'sections.contact.submit' | t, type: 'submit', style: 'primary', css_class: 'contact-page__submit-btn' %}
      {% endform %}
    </div>

    <aside class="contact-page__info">
      <div class="contact-page__info-section">
        <h3>{{ 'sections.contact.get_in_touch' | t }}</h3>
        {% if section.settings.email != blank %}
          <div class="contact-page__info-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
          </div>
        {% endif %}
        {% if section.settings.phone != blank %}
          <div class="contact-page__info-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <a href="tel:{{ section.settings.phone | remove: ' ' }}">{{ section.settings.phone }}</a>
          </div>
        {% endif %}
        {% if section.settings.whatsapp != blank %}
          <div class="contact-page__info-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21"/></svg>
            <a href="https://wa.me/{{ section.settings.whatsapp | remove: ' ' | remove: '+' }}" target="_blank" rel="noopener">{{ 'sections.contact.whatsapp_chat' | t }}</a>
          </div>
        {% endif %}
      </div>

      {% if section.settings.hours != blank %}
        <div class="contact-page__info-section">
          <h3>{{ 'sections.contact.business_hours' | t }}</h3>
          <div class="contact-page__hours">
            {{ section.settings.hours }}
          </div>
        </div>
      {% endif %}

      {% if section.settings.show_social %}
        <div class="contact-page__info-section">
          <h3>{{ 'sections.contact.follow_us' | t }}</h3>
          <div class="contact-page__social">
            {% if section.settings.social_instagram != blank %}
              <a href="{{ section.settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">Instagram</a>
            {% endif %}
            {% if section.settings.social_facebook != blank %}
              <a href="{{ section.settings.social_facebook }}" target="_blank" rel="noopener" aria-label="Facebook">Facebook</a>
            {% endif %}
            {% if section.settings.social_tiktok != blank %}
              <a href="{{ section.settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">TikTok</a>
            {% endif %}
          </div>
        </div>
      {% endif %}
    </aside>
  </div>
</section>

{% stylesheet %}
  .contact-page {
    padding: var(--space-2xl) 0 var(--space-4xl);
  }

  .contact-page__header {
    text-align: center;
    margin-bottom: var(--space-3xl);
  }

  .contact-page__title {
    font-size: var(--text-4xl);
    margin: 0;
  }

  .contact-page__description {
    font-size: var(--text-lg);
    color: var(--color-secondary);
    margin: var(--space-md) 0 0;
  }

  .contact-page__grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: var(--space-3xl);
    align-items: start;
  }

  .contact-page__form-title {
    font-size: var(--text-xl);
    margin: 0 0 var(--space-xl);
  }

  .contact-page__field {
    margin-bottom: var(--space-lg);
  }

  .contact-page__field label {
    display: block;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-foreground);
    margin-bottom: var(--space-xs);
  }

  .contact-page__field input,
  .contact-page__field textarea {
    width: 100%;
  }

  .contact-page__submit-btn {
    width: 100%;
  }

  .contact-page__success {
    background-color: var(--color-surface-brand);
    border-radius: var(--border-radius);
    padding: var(--space-md) var(--space-lg);
    margin-bottom: var(--space-lg);
    color: var(--color-primary-dark);
    font-size: var(--text-sm);
  }

  .contact-page__errors {
    background-color: #FEF2F2;
    border-radius: var(--border-radius);
    padding: var(--space-md) var(--space-lg);
    margin-bottom: var(--space-lg);
    color: #DC2626;
    font-size: var(--text-sm);
  }

  .contact-page__info {
    background-color: var(--color-surface-alt);
    border-radius: var(--border-radius);
    padding: var(--space-xl);
  }

  .contact-page__info-section {
    margin-bottom: var(--space-xl);
  }

  .contact-page__info-section:last-child {
    margin-bottom: 0;
  }

  .contact-page__info-section h3 {
    font-size: var(--text-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0 0 var(--space-md);
    color: var(--color-foreground);
  }

  .contact-page__info-item {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
  }

  .contact-page__info-item svg {
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .contact-page__info-item a {
    font-size: var(--text-sm);
    color: var(--color-foreground);
    text-decoration: none;
  }

  .contact-page__info-item a:hover {
    color: var(--color-primary);
  }

  .contact-page__hours {
    font-size: var(--text-sm);
    color: var(--color-secondary);
    line-height: 1.7;
  }

  .contact-page__social {
    display: flex;
    gap: var(--space-md);
  }

  .contact-page__social a {
    font-size: var(--text-sm);
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 500;
  }

  .contact-page__social a:hover {
    color: var(--color-primary-dark);
  }

  @media (max-width: 767px) {
    .contact-page__grid {
      grid-template-columns: 1fr;
      gap: var(--space-2xl);
    }

    .contact-page__title {
      font-size: var(--text-3xl);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.contact.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Get in touch"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:labels.description",
      "default": "Have a question? We'd love to hear from you."
    },
    {
      "type": "header",
      "content": "t:sections.contact.contact_info"
    },
    {
      "type": "text",
      "id": "email",
      "label": "t:sections.contact.email",
      "default": "hello@intelligenthome.com"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "t:sections.contact.phone"
    },
    {
      "type": "text",
      "id": "whatsapp",
      "label": "WhatsApp"
    },
    {
      "type": "richtext",
      "id": "hours",
      "label": "t:sections.contact.business_hours",
      "default": "<p>Monday – Friday: 9am – 6pm<br>Saturday: 10am – 4pm<br>Sunday: Closed</p>"
    },
    {
      "type": "header",
      "content": "t:labels.social"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "t:labels.show_social",
      "default": true
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "Instagram"
    },
    {
      "type": "url",
      "id": "social_facebook",
      "label": "Facebook"
    },
    {
      "type": "url",
      "id": "social_tiktok",
      "label": "TikTok"
    }
  ],
  "presets": [
    {
      "name": "t:sections.contact.name"
    }
  ]
}
{% endschema %}
