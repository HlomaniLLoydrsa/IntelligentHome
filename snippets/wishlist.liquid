{% doc %}
  Renders a wishlist heart icon for product cards and product pages.
  Uses localStorage to persist wishlist. No account required.

  @param {string} product_id - The product ID
  @param {string} product_url - The product URL
  @param {string} product_title - The product title
  @param {string} [product_image] - The product image URL
  @param {string} [product_price] - The product price string

  @example
  {% render 'wishlist', product_id: product.id, product_url: product.url, product_title: product.title, product_image: product.featured_image | image_url: width: 300, product_price: product.price | money %}
{% enddoc %}

<button
  type="button"
  class="wishlist-btn"
  data-wishlist-id="{{ product_id }}"
  data-wishlist-url="{{ product_url }}"
  data-wishlist-title="{{ product_title | escape }}"
  data-wishlist-image="{{ product_image }}"
  data-wishlist-price="{{ product_price }}"
  aria-label="{{ 'wishlist.add' | t }}"
>
  <svg class="wishlist-btn__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
</button>

{% stylesheet %}
  .wishlist-btn { position: absolute; top: var(--space-sm); right: var(--space-sm); display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; background-color: rgba(255,255,255,0.9); backdrop-filter: blur(4px); border: none; border-radius: 50%; cursor: pointer; color: var(--color-secondary); transition: color 0.2s ease, transform 0.2s ease, background-color 0.2s ease; z-index: 2; }
  .wishlist-btn:hover { color: #E53E3E; transform: scale(1.1); background-color: white; }
  .wishlist-btn--active { color: #E53E3E; }
  .wishlist-btn--active svg { fill: #E53E3E; }
  @keyframes wishlist-pop { 0%,100% { transform: scale(1); } 50% { transform: scale(1.3); } }
  .wishlist-btn--pop { animation: wishlist-pop 0.4s ease; }
{% endstylesheet %}

{% javascript %}
  (function() {
    var STORAGE_KEY = 'ih_wishlist';

    function getWishlist() {
      return JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
    }

    function saveWishlist(list) {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(list));
    }

    function isInWishlist(id) {
      return getWishlist().some(function(item) { return item.id === id; });
    }

    // Initialize all buttons on page
    document.querySelectorAll('.wishlist-btn').forEach(function(btn) {
      var id = btn.dataset.wishlistId;
      if (isInWishlist(id)) {
        btn.classList.add('wishlist-btn--active');
      }

      btn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        var list = getWishlist();
        var idx = list.findIndex(function(item) { return item.id === id; });

        if (idx > -1) {
          list.splice(idx, 1);
          btn.classList.remove('wishlist-btn--active');
        } else {
          list.push({
            id: id,
            url: btn.dataset.wishlistUrl,
            title: btn.dataset.wishlistTitle,
            image: btn.dataset.wishlistImage,
            price: btn.dataset.wishlistPrice
          });
          btn.classList.add('wishlist-btn--active');
          btn.classList.remove('wishlist-btn--pop');
          void btn.offsetWidth;
          btn.classList.add('wishlist-btn--pop');
        }
        saveWishlist(list);
      });
    });
  })();
{% endjavascript %}
