{% doc %}
  Renders a collapsible accordion item with a title and content.

  @param {string} title - The accordion heading text
  @param {string} content - The body content (supports HTML)
  @param {boolean} [open] - Whether the accordion starts open (default: false)

  @example
  {% render 'accordion', title: 'Description', content: product.description %}
  {% render 'accordion', title: 'Shipping', content: shipping_text, open: false %}
{% enddoc %}

<details class="accordion" {% if open %}open{% endif %}>
  <summary class="accordion__header">
    <span class="accordion__title">{{ title | escape }}</span>
    <span class="accordion__icon" aria-hidden="true">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
    </span>
  </summary>
  <div class="accordion__content">
    {{ content }}
  </div>
</details>

{% stylesheet %}
  .accordion {
    border-bottom: 1px solid var(--color-border);
  }

  .accordion__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-lg) 0;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .accordion__header::-webkit-details-marker {
    display: none;
  }

  .accordion__header::marker {
    display: none;
    content: '';
  }

  .accordion__title {
    font-family: var(--font-body-family);
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--color-foreground);
  }

  .accordion__icon {
    display: flex;
    align-items: center;
    color: var(--color-secondary);
    transition: transform 0.2s ease;
  }

  .accordion[open] .accordion__icon {
    transform: rotate(180deg);
  }

  .accordion__content {
    padding: 0 0 var(--space-lg);
    font-size: var(--text-sm);
    line-height: 1.7;
    color: var(--color-secondary);
  }

  .accordion__content p {
    margin: 0 0 var(--space-sm);
  }

  .accordion__content p:last-child {
    margin-bottom: 0;
  }
{% endstylesheet %}
