{% doc %}
  Renders a floating chat assistant bubble and panel.
  Answers FAQs with quick action buttons. Can be extended with AI API later.

  @example
  {% render 'chat-assistant' %}
{% enddoc %}

<div class="chat-assistant" id="chat-assistant">
  <button class="chat-assistant__bubble" id="chat-bubble" type="button" aria-label="{{ 'chat.open' | t }}">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
    <span class="chat-assistant__bubble-text">{{ 'chat.need_help' | t }}</span>
  </button>

  <div class="chat-assistant__panel" id="chat-panel" aria-hidden="true">
    <div class="chat-assistant__panel-header">
      <div>
        <strong class="chat-assistant__panel-title">{{ 'chat.title' | t }}</strong>
        <p class="chat-assistant__panel-subtitle">{{ 'chat.subtitle' | t }}</p>
      </div>
      <button class="chat-assistant__panel-close" id="chat-close" type="button" aria-label="{{ 'accessibility.close_modal' | t }}">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>

    <div class="chat-assistant__messages" id="chat-messages">
      <div class="chat-assistant__msg chat-assistant__msg--bot">
        <p>{{ 'chat.greeting' | t }}</p>
      </div>
    </div>

    <div class="chat-assistant__actions" id="chat-actions">
      <button type="button" class="chat-assistant__action-btn" data-answer="track_order">{{ 'chat.action_track' | t }}</button>
      <button type="button" class="chat-assistant__action-btn" data-answer="recommendations">{{ 'chat.action_recommendations' | t }}</button>
      <button type="button" class="chat-assistant__action-btn" data-answer="shipping">{{ 'chat.action_shipping' | t }}</button>
      <button type="button" class="chat-assistant__action-btn" data-answer="returns">{{ 'chat.action_returns' | t }}</button>
      <button type="button" class="chat-assistant__action-btn" data-answer="support">{{ 'chat.action_support' | t }}</button>
    </div>
  </div>
</div>

{% stylesheet %}
  .chat-assistant { position: fixed; bottom: var(--space-xl); right: var(--space-xl); z-index: 150; }
  .chat-assistant__bubble { display: flex; align-items: center; gap: var(--space-sm); background-color: var(--color-primary); color: white; border: none; border-radius: 28px; padding: 12px 20px; cursor: pointer; box-shadow: 0 4px 16px rgba(46,125,50,0.3); transition: transform 0.2s ease, box-shadow 0.2s ease; font-size: var(--text-sm); font-weight: 500; }
  .chat-assistant__bubble:hover { transform: translateY(-2px); box-shadow: 0 6px 24px rgba(46,125,50,0.4); }
  .chat-assistant__bubble svg { flex-shrink: 0; }
  .chat-assistant__panel { display: none; position: absolute; bottom: 60px; right: 0; width: 340px; max-height: 480px; background-color: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--border-radius); box-shadow: 0 8px 32px rgba(0,0,0,0.12); flex-direction: column; overflow: hidden; }
  .chat-assistant__panel[aria-hidden="false"] { display: flex; }
  .chat-assistant__panel-header { display: flex; align-items: flex-start; justify-content: space-between; padding: var(--space-lg); border-bottom: 1px solid var(--color-border); background-color: var(--color-surface-brand); }
  .chat-assistant__panel-title { font-size: var(--text-base); color: var(--color-foreground); display: block; }
  .chat-assistant__panel-subtitle { font-size: var(--text-xs); color: var(--color-secondary); margin: 2px 0 0; }
  .chat-assistant__panel-close { background: none; border: none; cursor: pointer; color: var(--color-secondary); padding: 4px; border-radius: 50%; transition: background-color 0.2s ease; }
  .chat-assistant__panel-close:hover { background-color: var(--color-surface-alt); }
  .chat-assistant__messages { flex: 1; overflow-y: auto; padding: var(--space-md) var(--space-lg); min-height: 120px; }
  .chat-assistant__msg { margin-bottom: var(--space-md); }
  .chat-assistant__msg--bot p { background-color: var(--color-surface-alt); border-radius: var(--border-radius); padding: var(--space-sm) var(--space-md); font-size: var(--text-sm); line-height: 1.5; color: var(--color-foreground); margin: 0; display: inline-block; }
  .chat-assistant__msg--user p { background-color: var(--color-primary); color: white; border-radius: var(--border-radius); padding: var(--space-sm) var(--space-md); font-size: var(--text-sm); line-height: 1.5; margin: 0; display: inline-block; float: right; clear: both; }
  .chat-assistant__actions { padding: var(--space-sm) var(--space-lg) var(--space-lg); display: flex; flex-wrap: wrap; gap: var(--space-xs); }
  .chat-assistant__action-btn { background-color: var(--color-surface); border: 1px solid var(--color-border); border-radius: 20px; padding: 6px 14px; font-size: var(--text-xs); color: var(--color-foreground); cursor: pointer; transition: border-color 0.2s ease, background-color 0.2s ease; white-space: nowrap; }
  .chat-assistant__action-btn:hover { border-color: var(--color-primary); background-color: var(--color-surface-brand); color: var(--color-primary-dark); }
  @media (max-width: 767px) { .chat-assistant { bottom: var(--space-md); right: var(--space-md); } .chat-assistant__bubble-text { display: none; } .chat-assistant__bubble { padding: 14px; border-radius: 50%; } .chat-assistant__panel { width: calc(100vw - 2 * var(--space-md)); right: 0; bottom: 56px; } }
{% endstylesheet %}

{% javascript %}
  (function() {
    var bubble = document.getElementById('chat-bubble');
    var panel = document.getElementById('chat-panel');
    var closeBtn = document.getElementById('chat-close');
    var messagesEl = document.getElementById('chat-messages');
    var actionsEl = document.getElementById('chat-actions');
    if (!bubble || !panel) return;

    var answers = {
      track_order: 'You can track your order on our Track Order page. Just enter your order number and email address.',
      recommendations: 'For kitchen essentials, our best sellers are a great place to start! Browse our Kitchen collection for curated picks.',
      shipping: 'We offer standard delivery (3–7 days) and express shipping (1–2 days). Free shipping on orders over $50.',
      returns: 'We accept returns within 30 days. Items must be unused and in original packaging. Refunds are processed in 5–7 business days.',
      support: 'You can reach us at hello@intelligenthome.com or through our Contact page. We respond within 24 hours.'
    };

    function togglePanel() {
      var hidden = panel.getAttribute('aria-hidden') === 'true';
      panel.setAttribute('aria-hidden', !hidden);
    }

    bubble.addEventListener('click', togglePanel);
    closeBtn.addEventListener('click', function() { panel.setAttribute('aria-hidden', 'true'); });

    actionsEl.addEventListener('click', function(e) {
      var btn = e.target.closest('[data-answer]');
      if (!btn) return;
      var key = btn.dataset.answer;
      var question = btn.textContent;
      var answer = answers[key] || 'I can help with that! Please visit our FAQ page for more details.';

      // Add user message
      var userMsg = document.createElement('div');
      userMsg.className = 'chat-assistant__msg chat-assistant__msg--user';
      userMsg.innerHTML = '<p>' + question + '</p>';
      messagesEl.appendChild(userMsg);

      // Add bot response after small delay
      setTimeout(function() {
        var botMsg = document.createElement('div');
        botMsg.className = 'chat-assistant__msg chat-assistant__msg--bot';
        botMsg.innerHTML = '<p>' + answer + '</p>';
        messagesEl.appendChild(botMsg);
        messagesEl.scrollTop = messagesEl.scrollHeight;
      }, 400);

      messagesEl.scrollTop = messagesEl.scrollHeight;
    });
  })();
{% endjavascript %}
