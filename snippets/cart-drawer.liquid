{% doc %}
  Renders a slide-in cart drawer from the right side of the page.
  Displays cart items, subtotal, and checkout button.
  Controlled via JS triggered from the header cart icon.

  @example
  {% render 'cart-drawer' %}
{% enddoc %}

<div class="cart-drawer" id="cart-drawer" aria-hidden="true" scroll-lock>
  <div class="cart-drawer__overlay"></div>
  <aside class="cart-drawer__panel" role="dialog" aria-label="{{ 'cart.title' | t }}">
    <div class="cart-drawer__header">
      <h2 class="cart-drawer__title">{{ 'cart.title' | t }} ({{ cart.item_count }})</h2>
      <button class="cart-drawer__close" aria-label="{{ 'accessibility.close_modal' | t }}">
        &times;
      </button>
    </div>

    {% if cart.item_count > 0 %}
      <div class="cart-drawer__items">
        {% for item in cart.items %}
          <div class="cart-drawer__item">
            <a href="{{ item.url }}" class="cart-drawer__item-image">
              {% if item.image %}
                <img
                  src="{{ item.image | image_url: width: 80 }}"
                  alt="{{ item.title | escape }}"
                  width="80"
                  height="80"
                  loading="lazy"
                >
              {% endif %}
            </a>
            <div class="cart-drawer__item-info">
              <a href="{{ item.url }}" class="cart-drawer__item-title">{{ item.product.title | escape }}</a>
              {% if item.variant.title != 'Default Title' %}
                <p class="cart-drawer__item-variant">{{ item.variant.title | escape }}</p>
              {% endif %}
              <p class="cart-drawer__item-price">{{ item.final_line_price | money }} <span class="cart-drawer__item-qty">&times;{{ item.quantity }}</span></p>
            </div>
            <a href="{{ item.url_to_remove }}" class="cart-drawer__item-remove" aria-label="{{ 'cart.remove' | t }}">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </a>
          </div>
        {% endfor %}
      </div>

      <div class="cart-drawer__footer">
        <div class="cart-drawer__subtotal">
          <span>{{ 'cart.subtotal' | t }}</span>
          <span class="cart-drawer__subtotal-value">{{ cart.total_price | money }}</span>
        </div>
        <p class="cart-drawer__shipping-note">{{ 'cart.shipping_note' | t }}</p>
        <a href="/checkout" class="btn btn--primary cart-drawer__checkout-btn">{{ 'cart.checkout' | t }}</a>
        <a href="{{ routes.cart_url }}" class="cart-drawer__view-cart">{{ 'cart.view_cart' | t }}</a>
      </div>
    {% else %}
      <div class="cart-drawer__empty">
        <p>{{ 'cart.empty' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary">{{ 'cart.continue_shopping' | t }}</a>
      </div>
    {% endif %}
  </aside>
</div>

{% stylesheet %}
  .cart-drawer {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 250;
  }

  .cart-drawer[open] {
    display: block;
  }

  .cart-drawer__overlay {
    position: absolute;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.4);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .cart-drawer[open] .cart-drawer__overlay {
    opacity: 1;
  }

  .cart-drawer__panel {
    position: absolute;
    top: 0;
    right: 0;
    width: min(400px, 90vw);
    height: 100%;
    background-color: var(--color-surface);
    transform: translateX(100%);
    transition: transform 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  .cart-drawer[open] .cart-drawer__panel {
    transform: translateX(0);
  }

  .cart-drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-lg) var(--space-xl);
    border-bottom: 1px solid var(--color-border);
    flex-shrink: 0;
  }

  .cart-drawer__title {
    font-family: var(--font-heading-family);
    font-size: var(--text-lg);
    font-weight: 600;
    margin: 0;
    color: var(--color-foreground);
  }

  .cart-drawer__close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    font-size: 1.5rem;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-foreground);
    border-radius: 50%;
    transition: background-color 0.2s ease;
  }

  .cart-drawer__close:hover {
    background-color: var(--color-surface-alt);
  }

  .cart-drawer__items {
    flex: 1;
    overflow-y: auto;
    padding: var(--space-md) var(--space-xl);
  }

  .cart-drawer__item {
    display: grid;
    grid-template-columns: 64px 1fr 24px;
    gap: var(--space-md);
    padding: var(--space-md) 0;
    border-bottom: 1px solid var(--color-border);
    align-items: start;
  }

  .cart-drawer__item:last-child {
    border-bottom: none;
  }

  .cart-drawer__item-image {
    border-radius: var(--border-radius);
    overflow: hidden;
    background-color: var(--color-surface-alt);
  }

  .cart-drawer__item-image img {
    width: 100%;
    height: 64px;
    object-fit: cover;
  }

  .cart-drawer__item-title {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-foreground);
    text-decoration: none;
    display: block;
  }

  .cart-drawer__item-title:hover {
    color: var(--color-primary);
  }

  .cart-drawer__item-variant {
    font-size: var(--text-xs);
    color: var(--color-secondary);
    margin: 2px 0 0;
  }

  .cart-drawer__item-price {
    font-size: var(--text-sm);
    color: var(--color-foreground);
    margin: var(--space-xs) 0 0;
  }

  .cart-drawer__item-qty {
    color: var(--color-secondary);
    font-size: var(--text-xs);
  }

  .cart-drawer__item-remove {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    color: var(--color-secondary);
    transition: color 0.2s ease;
  }

  .cart-drawer__item-remove:hover {
    color: var(--color-foreground);
  }

  .cart-drawer__footer {
    border-top: 1px solid var(--color-border);
    padding: var(--space-lg) var(--space-xl);
    flex-shrink: 0;
  }

  .cart-drawer__subtotal {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: var(--text-base);
    margin-bottom: var(--space-xs);
  }

  .cart-drawer__subtotal-value {
    font-weight: 600;
    font-size: var(--text-lg);
  }

  .cart-drawer__shipping-note {
    font-size: var(--text-xs);
    color: var(--color-secondary);
    margin: 0 0 var(--space-lg);
  }

  .cart-drawer__checkout-btn {
    width: 100%;
    text-align: center;
  }

  .cart-drawer__view-cart {
    display: block;
    text-align: center;
    margin-top: var(--space-md);
    font-size: var(--text-sm);
    color: var(--color-primary);
    text-decoration: none;
  }

  .cart-drawer__view-cart:hover {
    color: var(--color-primary-dark);
  }

  .cart-drawer__empty {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-lg);
    padding: var(--space-2xl);
    text-align: center;
  }

  .cart-drawer__empty p {
    font-size: var(--text-base);
    color: var(--color-secondary);
    margin: 0;
  }
{% endstylesheet %}

{% javascript %}
  (function() {
    var drawer = document.getElementById('cart-drawer');
    if (!drawer) return;
    var overlay = drawer.querySelector('.cart-drawer__overlay');
    var closeBtn = drawer.querySelector('.cart-drawer__close');
    var cartLinks = document.querySelectorAll('.header__cart');

    function openCartDrawer(e) {
      e.preventDefault();
      drawer.setAttribute('open', '');
      drawer.removeAttribute('aria-hidden');
      document.documentElement.style.overflow = 'hidden';
    }

    function closeCartDrawer() {
      drawer.removeAttribute('open');
      drawer.setAttribute('aria-hidden', 'true');
      document.documentElement.style.overflow = '';
    }

    cartLinks.forEach(function(link) {
      link.addEventListener('click', openCartDrawer);
    });

    closeBtn.addEventListener('click', closeCartDrawer);
    overlay.addEventListener('click', closeCartDrawer);

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && drawer.hasAttribute('open')) {
        closeCartDrawer();
      }
    });
  })();
{% endjavascript %}
