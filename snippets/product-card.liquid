{% doc %}
  Renders a product card with image, title, and price.
  Used in featured collections, collection pages, and search results.

  @param {product} product - The product object to render
  @param {boolean} [lazy] - Whether to lazy-load the image (default: true)
  @param {string} [css_class] - Additional CSS class for the card wrapper

  @example
  {% render 'product-card', product: product %}
  {% render 'product-card', product: product, lazy: false %}
{% enddoc %}

{% liquid
  assign lazy_load = lazy | default: true
%}

<article class="product-card {{ css_class }}">
  <a href="{{ product.url }}" class="product-card__link" aria-label="{{ product.title | escape }}">
    <div class="product-card__image-wrapper">
      {% if product.featured_image %}
        <img
          src="{{ product.featured_image | image_url: width: 600 }}"
          alt="{{ product.featured_image.alt | default: product.title | escape }}"
          width="600"
          height="{{ 600 | divided_by: product.featured_image.aspect_ratio | round }}"
          {% if lazy_load %}loading="lazy"{% endif %}
          class="product-card__image"
        >
      {% else %}
        <div class="product-card__placeholder">
          {{ 'product-1' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>

    <div class="product-card__info">
      <h3 class="product-card__title">{{ product.title | escape }}</h3>
      <p class="product-card__price">{{ product.price | money }}</p>
    </div>
  </a>
</article>

{% stylesheet %}
  .product-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .product-card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .product-card__image-wrapper {
    position: relative;
    overflow: hidden;
    border-radius: var(--border-radius);
    background-color: var(--color-surface-alt);
    aspect-ratio: 1 / 1;
  }

  .product-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .product-card__link:hover .product-card__image {
    transform: scale(1.03);
  }

  .product-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-xl);
  }

  .product-card__placeholder svg {
    width: 100%;
    height: auto;
    opacity: 0.4;
  }

  .product-card__info {
    padding: var(--space-md) 0;
  }

  .product-card__title {
    font-family: var(--font-body-family);
    font-size: var(--text-sm);
    font-weight: 500;
    margin: 0;
    color: var(--color-foreground);
  }

  .product-card__price {
    font-size: var(--text-sm);
    color: var(--color-secondary);
    margin: var(--space-xs) 0 0;
  }
{% endstylesheet %}
