{% doc %}
  Renders a predictive search overlay triggered from the header search icon.
  Uses Shopify's predictive search API to show results as the user types.

  @example
  {% render 'predictive-search' %}
{% enddoc %}

<div class="predictive-search" id="predictive-search" aria-hidden="true">
  <div class="predictive-search__overlay"></div>
  <div class="predictive-search__panel">
    <form action="{{ routes.search_url }}" method="get" role="search" class="predictive-search__form">
      <div class="predictive-search__input-wrapper">
        <svg class="predictive-search__icon" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="9" cy="9" r="5.25"/><path stroke-linecap="round" d="m13 13 3.5 3.5"/></svg>
        <input
          type="search"
          name="q"
          id="predictive-search-input"
          placeholder="{{ 'search.placeholder' | t }}"
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
          spellcheck="false"
          class="predictive-search__input"
        >
        <button type="button" class="predictive-search__close" aria-label="{{ 'accessibility.close_modal' | t }}">
          &times;
        </button>
      </div>
    </form>

    <div class="predictive-search__results" id="predictive-search-results" aria-live="polite">
      <!-- Results populated by JS -->
    </div>
  </div>
</div>

{% stylesheet %}
  .predictive-search {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 300;
  }

  .predictive-search[open] {
    display: block;
  }

  .predictive-search__overlay {
    position: absolute;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.4);
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .predictive-search[open] .predictive-search__overlay {
    opacity: 1;
  }

  .predictive-search__panel {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    background-color: var(--color-surface);
    max-height: 80vh;
    overflow-y: auto;
    transform: translateY(-10px);
    opacity: 0;
    transition: transform 0.2s ease, opacity 0.2s ease;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }

  .predictive-search[open] .predictive-search__panel {
    transform: translateY(0);
    opacity: 1;
  }

  .predictive-search__form {
    border-bottom: 1px solid var(--color-border);
  }

  .predictive-search__input-wrapper {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    max-width: var(--page-width);
    margin: 0 auto;
    padding: var(--space-lg) var(--page-margin);
  }

  .predictive-search__icon {
    flex-shrink: 0;
    color: var(--color-secondary);
  }

  .predictive-search__input {
    flex: 1;
    border: none;
    font-size: var(--text-lg);
    background: transparent;
    color: var(--color-foreground);
    padding: 0;
    min-height: auto;
  }

  .predictive-search__input:focus {
    outline: none;
    box-shadow: none;
  }

  .predictive-search__input::placeholder {
    color: var(--color-secondary);
  }

  .predictive-search__close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    font-size: 1.5rem;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-foreground);
    border-radius: 50%;
    transition: background-color 0.2s ease;
  }

  .predictive-search__close:hover {
    background-color: var(--color-surface-alt);
  }

  .predictive-search__results {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: var(--space-md) var(--page-margin) var(--space-xl);
  }

  .predictive-search__results:empty {
    display: none;
  }

  .predictive-search__result-group {
    margin-bottom: var(--space-lg);
  }

  .predictive-search__result-group-title {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-secondary);
    margin: 0 0 var(--space-sm);
  }

  .predictive-search__result-item {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-sm) 0;
    text-decoration: none;
    color: inherit;
    border-radius: var(--border-radius);
    transition: background-color 0.15s ease;
  }

  .predictive-search__result-item:hover {
    background-color: var(--color-surface-alt);
    padding-left: var(--space-sm);
    padding-right: var(--space-sm);
  }

  .predictive-search__result-image {
    width: 48px;
    height: 48px;
    border-radius: 6px;
    overflow: hidden;
    background-color: var(--color-surface-alt);
    flex-shrink: 0;
  }

  .predictive-search__result-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .predictive-search__result-title {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-foreground);
  }

  .predictive-search__result-price {
    font-size: var(--text-xs);
    color: var(--color-secondary);
    margin-top: 2px;
  }

  .predictive-search__no-results {
    font-size: var(--text-sm);
    color: var(--color-secondary);
    padding: var(--space-lg) 0;
    text-align: center;
  }

  .predictive-search__view-all {
    display: block;
    text-align: center;
    padding: var(--space-md) 0;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-primary);
    text-decoration: none;
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-md);
  }

  .predictive-search__view-all:hover {
    color: var(--color-primary-dark);
  }
{% endstylesheet %}

{% javascript %}
  (function() {
    var searchPanel = document.getElementById('predictive-search');
    if (!searchPanel) return;

    var overlay = searchPanel.querySelector('.predictive-search__overlay');
    var closeBtn = searchPanel.querySelector('.predictive-search__close');
    var input = document.getElementById('predictive-search-input');
    var resultsContainer = document.getElementById('predictive-search-results');
    var searchTriggers = document.querySelectorAll('a[href*="/search"]');
    var debounceTimer;

    function openSearch(e) {
      if (e) e.preventDefault();
      searchPanel.setAttribute('open', '');
      searchPanel.removeAttribute('aria-hidden');
      document.documentElement.style.overflow = 'hidden';
      setTimeout(function() { input.focus(); }, 100);
    }

    function closeSearch() {
      searchPanel.removeAttribute('open');
      searchPanel.setAttribute('aria-hidden', 'true');
      document.documentElement.style.overflow = '';
      input.value = '';
      resultsContainer.innerHTML = '';
    }

    // Attach to header search icon
    var headerSearchLink = document.querySelector('.header__action[aria-label]');
    if (headerSearchLink && headerSearchLink.getAttribute('aria-label') === document.querySelector('[aria-label="' + headerSearchLink.getAttribute('aria-label') + '"]')?.getAttribute('aria-label')) {
      // Find the search link specifically
      document.querySelectorAll('.header__action').forEach(function(link) {
        if (link.getAttribute('href') && link.getAttribute('href').indexOf('/search') !== -1) {
          link.addEventListener('click', openSearch);
        }
      });
    }

    closeBtn.addEventListener('click', closeSearch);
    overlay.addEventListener('click', closeSearch);

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && searchPanel.hasAttribute('open')) {
        closeSearch();
      }
    });

    // Predictive search
    input.addEventListener('input', function() {
      clearTimeout(debounceTimer);
      var query = input.value.trim();

      if (query.length < 2) {
        resultsContainer.innerHTML = '';
        return;
      }

      debounceTimer = setTimeout(function() {
        fetch('/search/suggest.json?q=' + encodeURIComponent(query) + '&resources[type]=product,article,page&resources[limit]=6')
          .then(function(res) { return res.json(); })
          .then(function(data) {
            renderResults(data, query);
          })
          .catch(function() {
            resultsContainer.innerHTML = '';
          });
      }, 300);
    });

    function renderResults(data, query) {
      var html = '';
      var resources = data.resources && data.resources.results;

      if (!resources) {
        resultsContainer.innerHTML = '<p class="predictive-search__no-results">No results found</p>';
        return;
      }

      var products = resources.products || [];
      var articles = resources.articles || [];
      var pages = resources.pages || [];

      if (products.length === 0 && articles.length === 0 && pages.length === 0) {
        resultsContainer.innerHTML = '<p class="predictive-search__no-results">No results found</p>';
        return;
      }

      if (products.length > 0) {
        html += '<div class="predictive-search__result-group">';
        html += '<p class="predictive-search__result-group-title">Products</p>';
        products.forEach(function(product) {
          var img = product.image ? '<div class="predictive-search__result-image"><img src="' + product.image + '" alt="" width="48" height="48"></div>' : '';
          var price = product.price ? '<p class="predictive-search__result-price">' + product.price + '</p>' : '';
          html += '<a href="' + product.url + '" class="predictive-search__result-item">' + img + '<div><p class="predictive-search__result-title">' + product.title + '</p>' + price + '</div></a>';
        });
        html += '</div>';
      }

      if (articles.length > 0) {
        html += '<div class="predictive-search__result-group">';
        html += '<p class="predictive-search__result-group-title">Articles</p>';
        articles.forEach(function(article) {
          html += '<a href="' + article.url + '" class="predictive-search__result-item"><div><p class="predictive-search__result-title">' + article.title + '</p></div></a>';
        });
        html += '</div>';
      }

      if (pages.length > 0) {
        html += '<div class="predictive-search__result-group">';
        html += '<p class="predictive-search__result-group-title">Pages</p>';
        pages.forEach(function(page) {
          html += '<a href="' + page.url + '" class="predictive-search__result-item"><div><p class="predictive-search__result-title">' + page.title + '</p></div></a>';
        });
        html += '</div>';
      }

      html += '<a href="/search?q=' + encodeURIComponent(query) + '" class="predictive-search__view-all">View all results</a>';
      resultsContainer.innerHTML = html;
    }
  })();
{% endjavascript %}
